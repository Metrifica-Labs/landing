{
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "build/web",
  "framework": null,
  "rewrites": [
    {
      "source": "/tower",
      "destination": "/tower/index.html"
    },
    {
      "source": "/tower/:path*",
      "destination": "/tower/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
